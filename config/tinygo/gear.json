{
  "llvm-target": "wasm32-unknown-unknown",
  "cpu": "mvp",

  "features":
  "+mutable-globals,-bulk-memory,-multivalue,-reference-types,-sign-ext,-nontrapping-fptoint",

  "build-tags": [
    "tinygo.wasm",
    "wasm_unknown",
    "gear"
  ],

  "buildmode": "c-shared",

  "goos": "linux",
  "goarch": "arm",

  "linker": "wasm-ld",
  "rtlib": "compiler-rt",
  "libc": "wasmbuiltins",

  "scheduler": "none",
  "gc": "leaking",

  "default-stack-size": 4096,

  "ldflags": [
    "--stack-first",
    "--no-demangle",
    "--no-entry",
    "--import-memory",
    "--initial-memory=134217728"
  ],

  "extra-files": [
    "src/runtime/asm_tinygowasm.S"
  ]
}
